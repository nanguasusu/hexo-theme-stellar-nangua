// Nangua custom UI layer.
$nangua-desktop-scale = hexo-config('nangua_ui.desktop_scale') || 1

:root
  --nangua-post-card-height: 192px
  --nangua-post-cover-width: 108px
  --nangua-sticker-bg: rgba(255, 253, 244, 0.72)
  --nangua-sticker-bg-strong: rgba(255, 253, 244, 0.84)
  --nangua-sticker-border: rgba(132, 204, 151, 0.42)
  --nangua-sticker-shadow: 0 18px 46px -30px rgba(34, 197, 94, 0.58), 0 8px 24px -22px rgba(15, 23, 42, 0.28)
  --nangua-sticker-radius: 30px
  --nangua-soft-line: rgba(132, 204, 151, 0.26)
  --nangua-cover-fade-width: 56px
  if hexo-config('nangua_ui.post_list.card_height')
    --nangua-post-card-height: convert(hexo-config('nangua_ui.post_list.card_height'))
  if hexo-config('nangua_ui.post_list.cover_width')
    --nangua-post-cover-width: convert(hexo-config('nangua_ui.post_list.cover_width'))
  if hexo-config('nangua_ui.post_list.cover_fade_width')
    --nangua-cover-fade-width: convert(hexo-config('nangua_ui.post_list.cover_fade_width'))

// Make the 100% browser zoom feel as spacious as the previous 90% view.
// Widths and typography scale together on desktop; responsive/mobile rules stay unchanged.
if $nangua-desktop-scale != 1
  @media screen and (min-width: $device-laptop)
    html
      font-size: $fs-root * $nangua-desktop-scale
    :root
      --width-main: 720px * $nangua-desktop-scale
      --side-content-width: 224px * $nangua-desktop-scale
      --gap-margin: 16px * $nangua-desktop-scale
      --gap-padding: 16px * $nangua-desktop-scale
      --fsp: $fs-body * $nangua-desktop-scale
      --nangua-post-card-height: 192px * $nangua-desktop-scale
      --nangua-sticker-radius: 30px * $nangua-desktop-scale
      if hexo-config('nangua_ui.post_list.cover_width')
        --nangua-post-cover-width: convert(hexo-config('nangua_ui.post_list.cover_width')) * $nangua-desktop-scale
      else
        --nangua-post-cover-width: 108px * $nangua-desktop-scale
      --nangua-cover-fade-width: 56px * $nangua-desktop-scale
    @media screen and (min-width: $device-2k)
      :root
        --width-main: 780px * $nangua-desktop-scale
    @media screen and (min-width: $device-4k)
      :root
        --width-main: 860px * $nangua-desktop-scale

// Article focus mode: keep the TOC, hide the left sidebar and widen the reading column.
.focus-mode-toggle
  display: none !important
  .focus-mode-exit-path
    display: none

@media screen and (min-width: $device-laptop)
  .l_body.content[layout='post']
    transition: grid-template-columns .28s ease
    .l_left
      transition: width .28s ease, opacity .22s ease, visibility .22s ease, transform .28s ease
    .focus-mode-toggle
      display: flex !important

    .float-panel:has(.focus-mode-toggle)
      width: 48px
      height: 48px
      box-sizing: border-box
      border: 1px solid rgba(255, 255, 255, .76)
      background: rgba(255, 255, 255, .62)
      box-shadow: 0 10px 28px -18px rgba(51, 78, 59, .42), inset 0 1px rgba(255, 255, 255, .9)
      text-shadow: none
      backdrop-filter: saturate(115%) blur(12px)
      -webkit-backdrop-filter: saturate(115%) blur(12px)
      &:before
        margin: 0
        background: rgba(255, 255, 255, .42)
        backdrop-filter: none
        -webkit-backdrop-filter: none
      &:after
        display: none
      .focus-mode-toggle
        align-items: center
        justify-content: center
        width: 48px
        height: 48px
        box-sizing: border-box
        padding: 0
        border: 0
        color: #69b77d
        line-height: 1
        text-shadow: none
        &:hover
          color: #4c9f65
        >svg
          display: block
          width: 20px
          height: 20px
          margin: 0
          flex: 0 0 20px

  html[data-focus-mode='true']
    .l_body.content[layout='post']
      if hexo-config('nangua_ui.focus_mode.width')
        --width-main: convert(hexo-config('nangua_ui.focus_mode.width'))
      .l_left
        width: 0
        overflow: hidden
        visibility: hidden
        opacity: 0
        pointer-events: none
        transform: translateX(-18px)
      .focus-mode-toggle
        color: #69b77d
        .focus-mode-enter-path
          display: none
        .focus-mode-exit-path
          display: block

if hexo-config('nangua_ui.site_background.enabled')
  body
    if hexo-config('nangua_ui.site_background.color')
      background-color: convert(hexo-config('nangua_ui.site_background.color'))

  body>.sitebg
    if hexo-config('nangua_ui.site_background.color')
      background-color: convert(hexo-config('nangua_ui.site_background.color'))
    if hexo-config('nangua_ui.site_background.image')
      background-image: convert(hexo-config('nangua_ui.site_background.image'))
    else
      background-image: none
    background-position: center
    background-size: cover
    if hexo-config('nangua_ui.site_background.fixed')
      background-attachment: fixed
    .siteblur
      --blur-px: 0
      --blur-sat: 100%
      if hexo-config('nangua_ui.site_background.overlay')
        --blur-bg: convert(hexo-config('nangua_ui.site_background.overlay'))
      backdrop-filter: none
      -webkit-backdrop-filter: none
      box-shadow: none

if hexo-config('nangua_ui.leftbar_card.mode') == 'solid'
  .l_left
    .sidebg
      --inset: 0
      background-image: none !important
      filter: none
      background-color: var(--nangua-sticker-bg)
      border: 1px solid var(--nangua-sticker-border)
      box-shadow: var(--nangua-sticker-shadow)
      backdrop-filter: saturate(135%) blur(14px)
      -webkit-backdrop-filter: saturate(135%) blur(14px)
      @media screen and (prefers-color-scheme: dark)
        background-color: rgba(20, 31, 28, 0.78)
    .leftbar-container
      background: transparent
      border: 0
      box-shadow: none
      border-radius: var(--nangua-sticker-radius)
      &:before
        display: none
      &:after
        display: none
      >.widgets
        mask: none
        -webkit-mask: none

.l_left
  border-radius: var(--nangua-sticker-radius)

.l_right
  border-radius: var(--nangua-sticker-radius)
  .widgets:not(:empty)
    padding: 1rem .75rem
    border: 1px solid var(--nangua-sticker-border)
    border-radius: var(--nangua-sticker-radius)
    background: var(--nangua-sticker-bg)
    box-shadow: var(--nangua-sticker-shadow)
    backdrop-filter: saturate(135%) blur(14px)
    -webkit-backdrop-filter: saturate(135%) blur(14px)
    @media screen and (prefers-color-scheme: dark)
      background: rgba(20, 31, 28, 0.78)
  .widget-wrapper
    padding-bottom: 1.25rem
    &+.widget-wrapper
      padding-top: 1rem
      border-top: 1px solid var(--nangua-soft-line)
    .widget-header
      padding-left: .5rem
      padding-right: .5rem
      color: var(--text-p2)
      .name
        letter-spacing: 0
        font-weight: 500
        opacity: .72

.l_right .widgets .widget-wrapper.toc
  background: transparent !important
  padding: 0
  .widget-body
    &:before
      width: 2px
      left: 6px
      background: linear-gradient(to bottom, transparent, var(--nangua-soft-line), transparent)
  .toc
    --fsp: $fsp2
    a
      margin: 2px 0 2px .5rem
      padding-top: 6px
      padding-bottom: 6px
      color: var(--text-p3)
      border-radius: 14px !important
      &:hover
        background: rgba(132, 204, 151, 0.14) !important
        color: var(--text-p1) !important
      &.active
        color: var(--text) !important
        background: rgba(132, 204, 151, 0.18) !important
        &:before
          left: -5px
          width: 3px
          background: rgba(34, 197, 94, 0.72) !important
          border-radius: 999px
  .widget-footer
    &:before
      background: var(--nangua-soft-line)
    a:hover
      background: rgba(132, 204, 151, 0.14)

.l_body.content article.content
  margin: 1rem 0 0
  padding: 1.75rem 2rem
  border: 1px solid rgba(255, 255, 255, 0.72)
  border-radius: var(--nangua-sticker-radius)
  background: rgba(255, 255, 255, 0.78)
  box-shadow: 0 20px 52px -38px rgba(15, 23, 42, 0.35)
  backdrop-filter: saturate(125%) blur(10px)
  -webkit-backdrop-filter: saturate(125%) blur(10px)
  line-height: 1.82
  @media screen and (prefers-color-scheme: dark)
    background: rgba(17, 24, 39, 0.76)
    border-color: rgba(255, 255, 255, 0.08)
  @media screen and (max-width: $device-mobile-max)
    margin: .75rem 1rem 0
    padding: 1.25rem
    border-radius: 24px
  p:not([class])
    line-height: 1.9
    margin-top: 1em
    margin-bottom: 1em
  h1,h2,h3,h4
    line-height: 1.45
  img
    border-radius: $border-image

.post-list.post
  .post-card.post
    background: var(--nangua-sticker-bg-strong)
    border: 1px solid rgba(255, 255, 255, 0.68)
    box-shadow: 0 18px 44px -36px rgba(15, 23, 42, 0.42)
    backdrop-filter: saturate(120%) blur(8px)
    -webkit-backdrop-filter: saturate(120%) blur(8px)

if hexo-config('nangua_ui.post_list.cover_position') == 'left'
  @media screen and (min-width: $device-mobile-max)
    .post-list.post
      .post-card.post
        transition: transform .2s ease, box-shadow .2s ease
        &:hover
          transform: translateY(-2px)
        article.has-cover
          display: flex
          align-items: stretch
          padding: 0
          height: var(--nangua-post-card-height)
          min-height: var(--nangua-post-card-height)
          .post-cover
            flex: 0 0 var(--nangua-post-cover-width)
            width: var(--nangua-post-cover-width)
            margin: 0
            border-radius: 0
            background: transparent
            img
              display: block
              width: 100%
              height: 100%
              min-height: var(--nangua-post-card-height)
              aspect-ratio: auto
              object-fit: cover
              -webkit-mask-image: linear-gradient(to right, #000 calc(100% - var(--nangua-cover-fade-width)), transparent)
              mask-image: linear-gradient(to right, #000 calc(100% - var(--nangua-cover-fade-width)), transparent)
          .post-card-body
            min-width: 0
            flex: 1
            display: flex
            flex-direction: column
            justify-content: center
            padding: 1rem 1.25rem
          .post-title
            margin-top: 0
            line-height: 1.45
            padding: 0
            overflow: visible
          .excerpt
            margin: .5rem 0 .75rem
            >p
              margin: 0
              display: -webkit-box
              overflow: hidden
              -webkit-line-clamp: 2
              -webkit-box-orient: vertical

  @media screen and (max-width: $device-mobile-max)
    .post-list.post
      .post-card.post article.has-cover
        .post-card-body
          padding: 0

// Compact botanical sidebar inspired by the Nangua notebook card.
@media screen and (min-width: $device-mobile-max)
  .l_body .l_left
    // The card is 100vh minus 128px; a 64px sticky offset centers it vertically.
    top: calc(var(--gap-margin) + 48px)

.l_left
  .leftbar-container
    text-align: left
  .header
    margin: 24px 28px 0
  .logo-wrap
    min-height: 0
    flex-direction: column
    align-items: center
    overflow: visible
    text-align: center
    a.avatar
      width: 64px
      height: 64px
      margin: 0
      border-radius: 50%
    a.title
      margin-top: 8px
      font-size: 1.45rem
      line-height: 1.25
      .sub
        margin-top: 2px
        font-size: $fs-12
        font-weight: 400
        color: var(--text-p3)

  .nav-area
    margin: 14px 32px 12px
    .menu
      margin: 0
      grid-gap: 12px
      .nav-item
        min-height: 48px
        border: 1px solid rgba(255, 255, 255, .72)
        border-radius: 11px
        background: rgba(255, 255, 255, .72)
        box-shadow: 0 5px 16px -12px rgba(15, 23, 42, .45)
        img,svg
          height: 24px
          filter: grayscale(20%) opacity(.72)
        &.active,&:hover
          background: rgba(255, 255, 255, .96)
          box-shadow: 0 7px 18px -12px rgba(15, 23, 42, .5)
        &.active:after
          display: none

  >.leftbar-container>.widgets
    margin: 0 24px
    border-radius: 0

  .search-wrapper
    box-sizing: border-box
    padding: 0 0 16px
    >.search-form
      position: relative
      height: 34px
      border: 1px solid rgba(112, 139, 120, .18)
      border-radius: 999px
      background: rgba(255, 255, 255, .62)
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, .8)
      overflow: hidden
      &:before
        display: none
      &:hover,&:has(input:focus),&:has(input:not(:placeholder-shown))
        background: rgba(255, 255, 255, .92)
        border-color: rgba(96, 165, 120, .34)
    .search-button
      height: 34px
      padding-left: 11px
      svg
        width: 16px
        height: 16px
        color: var(--text-p3)
    .search-input
      min-width: 0
      padding: 8px
      font-size: $fs-12
    .search-shortcut
      flex-shrink: 0
      margin-right: 10px
      padding: 0
      border: 0
      color: var(--text-p3)
      background: transparent
      font-family: $ff-body
      font-size: 11px
      white-space: nowrap

  .widget-wrapper
    padding-bottom: 18px
    .widget-header
      padding: 0 2px 5px
      line-height: 24px
      font-size: $fs-12
      color: var(--text-p2)
      .recent-heading
        display: inline-flex
        align-items: center
        gap: 7px
        opacity: 1
        svg,img
          width: 13px
          height: 13px
          color: #69b77d

  .widget-wrapper.post-list .widget-body
    a
      position: relative
      min-height: 20px
      padding: 3px 4px 3px 18px
      border-radius: 8px
      font-size: $fs-12
      line-height: 1.35
      &:before
        content: ''
        position: absolute
        left: 5px
        top: 50%
        width: 4px
        height: 4px
        border-radius: 50%
        background: #a8d9b3
        transform: translateY(-50%)
      &.active,&:hover
        background: rgba(132, 204, 151, .13)
    a+a
      margin-top: 1px

  footer.footer
    flex-shrink: 0
    margin: 0 24px 20px
    padding-top: 12px
    border-top: 1px solid rgba(112, 139, 120, .16)
    .social-wrap
      display: flex
      justify-content: center
      gap: 24px
      .social
        display: flex
        align-items: center
        justify-content: center
        width: 28px
        height: 28px
        box-sizing: border-box
        padding: 5px
        color: var(--text-p3)
        filter: grayscale(100%) opacity(.8)
        svg,img
          width: 18px
          height: 18px
        &:hover
          color: #69b77d
          background: rgba(132, 204, 151, .14)
          filter: none
    .sidebar-copyright
      margin-top: 8px
      color: var(--text-p3)
      font-size: 11px
      line-height: 1.4
      text-align: center

@media screen and (prefers-color-scheme: dark)
  .l_left
    .nav-area .menu .nav-item,
    .search-wrapper >.search-form
      border-color: rgba(255, 255, 255, .08)
      background: rgba(17, 24, 39, .56)
    .nav-area .menu .nav-item:hover,
    .nav-area .menu .nav-item.active,
    .search-wrapper >.search-form:hover,
    .search-wrapper >.search-form:has(input:focus)
      background: rgba(31, 41, 55, .92)

@media screen and (max-width: $device-mobile-max)
  .l_left
    .header
      margin-top: 20px
    footer.footer
      margin-bottom: 14px

// Botanical journal cards in the home/index right sidebar.
@media screen and (min-width: $device-laptop)
  .l_body .l_right:has(.nangua-desk)
    align-self: start
  .l_right .nangua-desk.nangua-desk-fixed
    position: fixed
    z-index: 8
    top: 50vh
    left: var(--nangua-desk-left)
    width: var(--nangua-desk-width)
    max-height: calc(100vh - 32px)
    overflow-y: auto
    transform: translateY(-50%)
    scrollbar-width: none
    &::-webkit-scrollbar
      display: none

.l_right .widgets.nangua-rightbar
  width: 100%
  box-sizing: border-box
  margin: 0 var(--gap-margin)
  padding: 0
  border: 0
  border-radius: 0
  background: transparent
  box-shadow: none
  backdrop-filter: none
  -webkit-backdrop-filter: none
  overflow: visible

.l_right .nangua-desk
  display: flex
  flex-direction: column
  gap: 16px
  padding: 0
  color: #4a534d
  font-size: 13px

.nangua-desk-card
  position: relative
  box-sizing: border-box
  overflow: hidden
  padding: 18px 20px
  border: 1px solid rgba(123, 164, 130, .18)
  border-radius: 22px
  background: rgba(255, 255, 251, .78)
  box-shadow: 0 15px 35px -27px rgba(52, 85, 60, .45), inset 0 1px rgba(255, 255, 255, .9)
  backdrop-filter: saturate(120%) blur(10px)
  -webkit-backdrop-filter: saturate(120%) blur(10px)

.nangua-calendar
  min-height: 154px
  padding-top: 23px
  text-align: center
  .nangua-year
    display: block
    margin-bottom: 1px
    color: #8a948b
    font-size: 11px
    letter-spacing: 1.5px
  .nangua-date
    display: block
    color: #252b27
    font-family: $ff-body
    font-size: 22px
    font-weight: 600
    letter-spacing: 2px
  .nangua-weekday
    margin-top: 5px
    color: #6e776f
    font-size: 14px
  .nangua-dotted-line
    width: 100px
    margin: 11px auto 10px
    border-top: 2px dotted rgba(120, 146, 124, .2)
  .nangua-time
    display: inline-block
    min-width: 106px
    padding: 6px 13px
    border-radius: 999px
    background: rgba(211, 229, 195, .56)
    color: #727b74
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace
    font-size: 13px
    letter-spacing: .4px

.nangua-sprig
  position: absolute
  top: 17px
  width: 55px
  height: 28px
  color: #bad59d
  fill: currentColor
  stroke: currentColor
  stroke-width: 1.5
  stroke-linecap: round
  opacity: .75
  &.nangua-sprig-left
    left: 16px
  &.nangua-sprig-right
    right: 16px
    transform: scaleX(-1)

.nangua-desk-title
  display: flex
  align-items: center
  gap: 7px
  height: 25px
  color: #3f4942
  font-size: 13px
  font-weight: 600
  letter-spacing: .5px
  .nangua-title-mark
    color: #76b58a
    font-size: 19px
    line-height: 1
  .nangua-title-stars
    margin-left: auto
    color: #c5dca5
    font-weight: 400
  .nangua-more
    margin-left: auto
    color: #57b57a
    letter-spacing: 1px

.nangua-desk-rows
  margin-top: 9px

.nangua-desk-row
  display: flex
  align-items: center
  justify-content: space-between
  min-height: 38px
  box-sizing: border-box
  color: #58615a
  text-decoration: none
  &+.nangua-desk-row
    border-top: 1px solid rgba(111, 138, 116, .13)
  strong
    color: #677069
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace
    font-size: 13px
    font-weight: 500
    font-variant-numeric: tabular-nums
    small
      font-family: $ff-body
      font-size: 11px
  &[href]
    border-radius: 9px
    transition: color .2s ease, background .2s ease
    &:hover
      color: #3d8e5b
      background: rgba(132, 204, 151, .1)
      strong
        color: #3d8e5b

.nangua-row-label
  display: inline-flex
  align-items: center
  gap: 9px

.desk-icon
  width: 17px
  height: 17px
  flex: 0 0 17px
  &.desk-icon-sun
    color: #ffb72f
  &.desk-icon-calendar
    color: #9a7cf3
  &.desk-icon-clock
    color: #68b979
  &.desk-icon-article
    color: #7d9cf6
  &.desk-icon-tag
    color: #f5a33c
  &.desk-icon-update
    color: #f17b82

.nangua-stats
  strong
    color: #42955f
  .nangua-desk-note
    margin: 10px 0 -1px
    padding-top: 12px
    border-top: 1px solid rgba(111, 138, 116, .13)
    color: #747d76
    font-size: 11px
    letter-spacing: .4px
    span
      color: #d7bc66

@media screen and (prefers-color-scheme: dark)
  .nangua-desk-card
    border-color: rgba(157, 196, 165, .13)
    background: rgba(20, 31, 28, .82)
    color: var(--text-p2)
  .nangua-calendar .nangua-date,
  .nangua-desk-title
    color: var(--text-p1)
  .nangua-calendar .nangua-weekday,
  .nangua-desk-row,
  .nangua-desk-row strong,
  .nangua-stats .nangua-desk-note
    color: var(--text-p2)
  .nangua-calendar .nangua-time
    background: rgba(121, 163, 107, .16)
    color: var(--text-p2)

@media screen and (max-width: $device-laptop)
  .l_right .widgets.nangua-rightbar
    margin: 0
    padding: 0
  .l_right .nangua-desk
    padding: 0
