// Nangua custom UI layer.
:root
  --nangua-post-cover-width: 220px
  if hexo-config('nangua_ui.post_list.cover_width')
    --nangua-post-cover-width: convert(hexo-config('nangua_ui.post_list.cover_width'))

if hexo-config('nangua_ui.site_background.enabled')
  body
    if hexo-config('nangua_ui.site_background.color')
      background-color: convert(hexo-config('nangua_ui.site_background.color'))

  body>.sitebg
    if hexo-config('nangua_ui.site_background.color')
      background-color: convert(hexo-config('nangua_ui.site_background.color'))
    if hexo-config('nangua_ui.site_background.image')
      background-image: convert(hexo-config('nangua_ui.site_background.image'))
    else
      background-image: none
    background-position: center
    background-size: cover
    if hexo-config('nangua_ui.site_background.fixed')
      background-attachment: fixed
    .siteblur
      --blur-px: 0
      --blur-sat: 100%
      if hexo-config('nangua_ui.site_background.overlay')
        --blur-bg: convert(hexo-config('nangua_ui.site_background.overlay'))
      backdrop-filter: none
      -webkit-backdrop-filter: none
      box-shadow: none

if hexo-config('nangua_ui.leftbar_card.mode') == 'solid'
  .l_left
    .sidebg
      --inset: 0
      background-image: none !important
      filter: none
      if hexo-config('nangua_ui.leftbar_card.color_light')
        background-color: convert(hexo-config('nangua_ui.leftbar_card.color_light'))
      else
        background-color: var(--card)
      @media screen and (prefers-color-scheme: dark)
        if hexo-config('nangua_ui.leftbar_card.color_dark')
          background-color: convert(hexo-config('nangua_ui.leftbar_card.color_dark'))
        else
          background-color: var(--card)
    .leftbar-container
      background: transparent
      border: 1px solid var(--block-border)
      box-shadow: 0 10px 30px -22px rgba(15, 23, 42, 0.35)
      &:before
        display: none
      &:after
        display: none
      >.widgets
        mask: none
        -webkit-mask: none

if hexo-config('nangua_ui.post_list.cover_position') == 'left'
  @media screen and (min-width: $device-mobile-max)
    .post-list.post
      .post-card.post
        transition: transform .2s ease, box-shadow .2s ease
        &:hover
          transform: translateY(-2px)
        article.has-cover
          display: flex
          align-items: stretch
          padding: 0
          min-height: 156px
          .post-cover
            flex: 0 0 var(--nangua-post-cover-width)
            width: var(--nangua-post-cover-width)
            margin: 0
            border-radius: 0
            img
              display: block
              width: 100%
              height: 100%
              min-height: 156px
              aspect-ratio: auto
              object-fit: cover
          .post-card-body
            min-width: 0
            flex: 1
            display: flex
            flex-direction: column
            justify-content: center
            padding: 1rem 1.25rem
          .post-title
            margin-top: 0
          .excerpt
            margin: .5rem 0 .75rem
            >p
              margin: 0

  @media screen and (max-width: $device-mobile-max)
    .post-list.post
      .post-card.post article.has-cover
        .post-card-body
          padding: 0
